{
  "name": "ask-bonk",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist/ask_bonk --var BONK_VERSION:ci --var BONK_COMMIT:local",
    "deploy": "wrangler deploy --config wrangler.jsonc --var BONK_VERSION:\"$(git describe --tags --always)\" --var BONK_COMMIT:\"$(git rev-parse --short HEAD)\"",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "vitest",
    "typecheck:action": "tsc --noEmit -p tsconfig.github-action.json",
    "cf-typegen": "wrangler types",
    "cli:build": "bun build cli/index.ts --compile --outfile cli/bonk",
    "cli": "bun run cli/index.ts",
    "lint": "oxlint",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@flue/github": "^2.0.3",
    "@flue/runtime": "^2.0.3",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "agents": "^0.17.4",
    "ai": "^7.0.58",
    "better-result": "^2.10.0",
    "hono": "4.12.32",
    "jose": "^6.2.8",
    "shescape": "^3.0.2",
    "ulid": "^3.0.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@octokit/webhooks-types": "^7.6.1",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "hono": "4.12.32",
    "@cloudflare/vite-plugin": "^1.47.0"
  }
}
